# ============================================
#  ROBLOX SUPPLYZ — Variáveis de Ambiente
# ============================================
# Copie este arquivo para .env e preencha:
#   copy .env.example .env

# ---------- SERVIDOR ----------
PORT=3000
SESSION_SECRET=troque-por-uma-string-aleatoria-longa
# Gere uma aleatória:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# ---------- GOOGLE OAUTH 2.0 ----------
# Crie em: https://console.cloud.google.com/apis/credentials
# Tipo: "ID do cliente OAuth" → Aplicativo da Web
# URI de redirecionamento: http://localhost:3000/auth/google/callback
# EM PRODUÇÃO: https://SEU-DOMINIO/auth/google/callback
GOOGLE_CLIENT_ID=SEU_CLIENT_ID_AQUI
GOOGLE_CLIENT_SECRET=SEU_CLIENT_SECRET_AQUI

# ---------- MERCADO PAGO ----------
# Crie em: https://www.mercadopago.com.br/developers/panel/app
# Use as credenciais de PRODUÇÃO quando for ao ar
MERCADO_PAGO_ACCESS_TOKEN=SEU_ACCESS_TOKEN_AQUI
MERCADO_PAGO_PUBLIC_KEY=SEU_PUBLIC_KEY_AQUI
# Webhook secret (valida a assinatura do /api/pix/webhook)
MERCADO_PAGO_WEBHOOK_SECRET=

# ---------- ADMIN ----------
# E-mail do Google que terá acesso admin automaticamente
ADMIN_EMAIL=seu-email-admin@gmail.com

# ---------- DISCORD ----------
# Webhook do canal de admin: Config. do canal → Integrações → Webhooks
# Avisos: venda aprovada, chat de cliente, pool acabando
DISCORD_WEBHOOK_URL=

# ---------- OPERAÇÃO ----------
# Expiração do QR PIX em minutos (a varredura cancela o que passar disso)
PIX_EXPIRATION_MINUTES=30

# ---------- SÓ EM PRODUÇÃO COM VOLUME/DISCO PERSISTENTE ----------
# DB_PATH=/data/supplyz.db
# UPLOAD_DIR=/data/uploads
