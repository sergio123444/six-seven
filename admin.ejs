  <!-- ==================== TOAST ==================== -->
  <div id="toast" class="toast"></div>

  <!-- ==================== BOOTSTRAP DATA ==================== -->
  <script>
    window.ADMIN_THREADS  = <%- JSON.stringify(threads).replace(/</g, '\\u003c') %>;
    window.ADMIN_PRODUCTS = <%- JSON.stringify(products.map(p => ({ id: p.id, name: p.name, price: p.price, description: p.description, image: p.image, key_pool: p.key_pool, plan_group: p.plan_group, plan_label: p.plan_label }))).replace(/</g, '\\u003c') %>;
  </script>

  <!-- ==================== JAVASCRIPT ==================== -->
  <script>
    // ── Toast de notificação ──
    function showToast(message, type = 'success') {
      const toast = document.getElementById('toast');
      toast.textContent = message;
      toast.className = 'toast ' + type + ' show';
      setTimeout(() => { toast.classList.remove('show'); }, 3000);
    }

    // ── Filtro por status (pedidos) ──
    function filterByStatus(value) {
      window.location.href = '/admin?status=' + value;
    }

    // ── Aprovar pedido ──
    async function approveOrder(orderId) {
      try {
        const res = await fetch('/admin/api/orders/' + orderId + '/approve', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({})
        });
        const data = await res.json();
        if (res.ok) {
          showToast('Pedido #' + orderId + ' aprovado!', 'success');
          setTimeout(() => location.reload(), 800);
        } else {
          showToast(data.error || 'Erro ao aprovar pedido.', 'error');
        }
      } catch (err) {
        showToast('Erro de conexão.', 'error');
      }
    }

    // ── Cancelar pedido ──
    async function cancelOrder(orderId) {
      if (!confirm('Tem certeza que deseja cancelar o pedido #' + orderId + '?')) return;
      try {
        const res = await fetch('/admin/api/orders/' + orderId + '/cancel', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({})
        });
        const data = await res.json();
        if (res.ok) {
          showToast('Pedido #' + orderId + ' cancelado.', 'success');
          setTimeout(() => location.reload(), 800);
        } else {
          showToast(data.error || 'Erro ao cancelar pedido.', 'error');
        }
      } catch (err) {
        showToast('Erro de conexão.', 'error');
      }
    }

    // ── Toggle produto (ativar/desativar) ──
    async function toggleProduct(productId) {
      try {
        const res = await fetch('/admin/api/products/' + productId + '/toggle', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({})
        });
        const data = await res.json();
        if (res.ok) {
          showToast('Produto atualizado!', 'success');
          setTimeout(() => location.reload(), 800);
        } else {
          showToast(data.error || 'Erro ao atualizar produto.', 'error');
        }
      } catch (err) {
        showToast('Erro de conexão.', 'error');
      }
    }

    // ── Atualizar estoque ──
    async function updateStock(productId) {
      const input = document.getElementById('stock-' + productId);
      const stock = parseInt(input.value);
      if (isNaN(stock) || stock < 0) {
        showToast('Valor de estoque inválido.', 'error');
        return;
      }
      try {
        const res = await fetch('/admin/api/products/' + productId + '/stock', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ stock: stock })
        });
        const data = await res.json();
        if (res.ok) {
          showToast('Estoque atualizado!', 'success');
          setTimeout(() => location.reload(), 800);
        } else {
          showToast(data.error || 'Erro ao atualizar estoque.', 'error');
        }
      } catch (err) {
        showToast('Erro de conexão.', 'error');
      }
    }

    // ── Revogar licença ──
    async function revokeLicense(licenseId) {
      if (!confirm('Tem certeza que deseja revogar esta licença?')) return;
      try {
        const res = await fetch('/admin/api/licenses/' + licenseId + '/revoke', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({})
        });
        const data = await res.json();
        if (res.ok) {
          showToast('Licença revogada.', 'success');
          setTimeout(() => location.reload(), 800);
        } else {
          showToast(data.error || 'Erro ao revogar licença.', 'error');
        }
      } catch (err) {
        showToast('Erro de conexão.', 'error');
      }
    }

    // ── Adicionar lote de keys ao pool ──
    async function addKeys(productId) {
      const ta = document.getElementById('keys-' + productId);
      const keys = ta.value.trim();

      if (!keys) {
        showToast('Cole as keys primeiro (uma por linha).', 'error');
        return;
      }

      try {
        const res = await fetch('/admin/api/products/' + productId + '/keys', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ keys })
        });
        const data = await res.json();
        if (res.ok) {
          showToast(data.added + ' key(s) adicionadas!', 'success');
          setTimeout(() => location.reload(), 800);
        } else {
          showToast(data.error || 'Erro ao adicionar keys.', 'error');
        }
      } catch (err) {
        showToast('Erro de conexão.', 'error');
      }
    }

    // ── Copiar key para clipboard ──
    async function copyKey(key) {
      try {
        await navigator.clipboard.writeText(key);
        showToast('Key copiada para a área de transferência!', 'success');
      } catch (err) {
        // Fallback para navegadores mais antigos
        const textArea = document.createElement('textarea');
        textArea.value = key;
        textArea.style.position = 'fixed';
        textArea.style.opacity = '0';
        document.body.appendChild(textArea);
        textArea.select();
        document.execCommand('copy');
        document.body.removeChild(textArea);
        showToast('Key copiada!', 'success');
      }
    }

    // ════════════════════════════════════════════════
    //  PRODUTOS — criar / editar
    // ════════════════════════════════════════════════
    let pfEditing = null;

    function openProductForm(productId) {
      const form = document.getElementById('product-form');
      form.style.display = 'block';
      document.getElementById('pf-note').textContent = '';

        if (productId) {
        const p = (window.ADMIN_PRODUCTS || []).find(x => x.id === productId);
        if (!p) return;
        pfEditing = p.id;
        document.getElementById('pf-title').textContent = 'EDITAR PRODUTO — ' + p.id;
        document.getElementById('pf-name').value  = p.name;
        document.getElementById('pf-slug').value  = p.id;
        document.getElementById('pf-slug').disabled = true;
        document.getElementById('pf-price').value = p.price;
        document.getElementById('pf-type').value  = p.key_pool ? 'pool' : 'generated';
        document.getElementById('pf-type').disabled = true;
        document.getElementById('pf-image').value = p.image || '';
        document.getElementById('pf-desc').value  = p.description || '';
        document.getElementById('pf-group').value = p.plan_group || '';
        document.getElementById('pf-plan').value  = p.plan_label || '';
      } else {
        pfEditing = null;
        document.getElementById('pf-title').textContent = 'NOVO PRODUTO';
        ['pf-name', 'pf-slug', 'pf-price', 'pf-image', 'pf-desc', 'pf-stock', 'pf-file', 'pf-group', 'pf-plan']
          .forEach(id => { const el = document.getElementById(id); if (el) el.value = ''; });
        document.getElementById('pf-slug').disabled = false;
        document.getElementById('pf-type').disabled = false;
        document.getElementById('pf-type').value = 'pool';
      }

      pfToggleStock();
      form.scrollIntoView({ behavior: 'smooth', block: 'center' });
    }

    function closeProductForm() {
      document.getElementById('product-form').style.display = 'none';
    }

    function pfToggleStock() {
      const isGen = document.getElementById('pf-type').value === 'generated';
      document.getElementById('pf-stock-field').style.display = (isGen && !pfEditing) ? 'block' : 'none';
    }

    async function uploadProductImage(file) {
      const fd = new FormData();
      fd.append('image', file);
      const res = await fetch('/admin/api/upload', { method: 'POST', body: fd });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || 'Falha no upload.');
      return data.url;
    }

    async function saveProduct() {
      const note = document.getElementById('pf-note');
      note.textContent = 'Salvando…';

      try {
        let image = document.getElementById('pf-image').value.trim();
        const file = document.getElementById('pf-file').files[0];
        if (file) image = await uploadProductImage(file);

        const payload = {
          name:  document.getElementById('pf-name').value.trim(),
          price: document.getElementById('pf-price').value,
          description: document.getElementById('pf-desc').value.trim(),
          image
        };

        let url;
        if (pfEditing) {
          url = '/admin/api/products/' + pfEditing + '/update';
          payload.plan_group = document.getElementById('pf-group').value.trim();
          payload.plan_label = document.getElementById('pf-plan').value.trim();
        } else {
          url = '/admin/api/products/create';
          payload.id = document.getElementById('pf-slug').value.trim();
          payload.key_pool = document.getElementById('pf-type').value === 'pool';
          payload.plan_group = document.getElementById('pf-group').value.trim();
          payload.plan_label = document.getElementById('pf-plan').value.trim();
          if (!payload.key_pool) {
            payload.stock = document.getElementById('pf-stock').value;
          }
        }

        const res = await fetch(url, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });
        const data = await res.json();

        if (!res.ok) {
          note.textContent = data.error || 'Erro ao salvar.';
          return;
        }

        showToast(pfEditing ? 'Produto atualizado!' : 'Produto criado!', 'success');
        setTimeout(() => location.reload(), 800);
      } catch (err) {
        note.textContent = err.message || 'Erro de conexão.';
      }
    }

    // ════════════════════════════════════════════════
    //  CHAT SUPORTE — painel do vendedor
    // ════════════════════════════════════════════════
    const chatAdmin = { selected: null, lastId: 0, timer: null };

    function threadInfo(id) {
      return (window.ADMIN_THREADS || []).find(t => t.id === id) || null;
    }

    async function selectThread(threadId) {
      chatAdmin.selected = threadId;
      chatAdmin.lastId = 0;

      document.querySelectorAll('.chat-thread').forEach(b => {
        b.classList.toggle('active', parseInt(b.dataset.thread) === threadId);
      });

      const t = threadInfo(threadId);
      document.getElementById('chat-pane-head').textContent = t
        ? `${t.order_email} — ${t.product_name} · pedido #${t.order_id}`
        : 'Conversa #' + threadId;

      document.getElementById('admin-chat-messages').innerHTML = '';
      document.getElementById('chat-pane-input').style.display = 'flex';
      updateCloseBtn();

      await adminChatPoll();
      if (chatAdmin.timer) clearInterval(chatAdmin.timer);
      chatAdmin.timer = setInterval(adminChatPoll, 4000);
    }

    function updateCloseBtn() {
      const t = threadInfo(chatAdmin.selected);
      const btn = document.getElementById('chat-close-btn');
      if (btn && t) btn.textContent = t.status === 'closed' ? 'Reabrir' : 'Encerrar';
    }

    function adminChatAppend(m) {
      const box = document.getElementById('admin-chat-messages');

      const row = document.createElement('div');
      row.className = 'chat-msg ' + (m.sender === 'customer' ? 'chat-msg-them' : 'chat-msg-me');

      const bubble = document.createElement('div');
      bubble.className = 'chat-bubble';

      const body = document.createElement('div');
      body.className = 'chat-body';
      body.textContent = m.body;

      const time = document.createElement('div');
      time.className = 'chat-time';
      time.textContent = (m.sender === 'customer' ? 'cliente · ' : 'você · ') + String(m.created_at).slice(11, 16);

      bubble.appendChild(body);
      bubble.appendChild(time);
      row.appendChild(bubble);
      box.appendChild(row);

      if (m.id > chatAdmin.lastId) chatAdmin.lastId = m.id;
      box.scrollTop = box.scrollHeight;
    }

    async function adminChatPoll() {
      if (!chatAdmin.selected) return;
      try {
        const res = await fetch(`/admin/api/chats/${chatAdmin.selected}/messages?after=${chatAdmin.lastId}`);
        if (!res.ok) return;
        const data = await res.json();
        for (const m of data.messages) adminChatAppend(m);
      } catch (e) { /* polling silencioso */ }
    }

    async function sendAdminMessage() {
      const input = document.getElementById('admin-chat-text');
      const body = input.value.trim();
      if (!body || !chatAdmin.selected) return;

      try {
        const res = await fetch(`/admin/api/chats/${chatAdmin.selected}/messages`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ body })
        });
        const data = await res.json();
        if (res.ok && data.message) {
          adminChatAppend(data.message);
          input.value = '';
        } else {
          showToast(data.error || 'Erro ao responder.', 'error');
        }
      } catch (e) {
        showToast('Erro de conexão.', 'error');
      }
    }

    async function toggleThreadStatus() {
      const t = threadInfo(chatAdmin.selected);
      if (!t) return;
      const next = t.status === 'closed' ? 'open' : 'closed';

      try {
        const res = await fetch(`/admin/api/chats/${t.id}/status`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ status: next })
        });
        if (res.ok) {
          t.status = next;
          updateCloseBtn();
          showToast(next === 'closed' ? 'Conversa encerrada.' : 'Conversa reaberta.', 'success');
        }
      } catch (e) {
        showToast('Erro de conexão.', 'error');
      }
    }

    // Enter dentro do input de resposta envia
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' && document.activeElement === document.getElementById('admin-chat-text')) {
        sendAdminMessage();
      }
    });

    // Lista de threads + contagem de não lidas — refresh a cada 6s
    async function refreshThreads() {
      try {
        const res = await fetch('/admin/api/chats');
        if (!res.ok) return;
        const threads = await res.json();
        window.ADMIN_THREADS = threads;
        rebuildThreadList(threads);

        const total = threads.reduce((acc, t) => acc + (t.unread || 0), 0);
        const el = document.getElementById('chat-admin-count');
        if (el) el.textContent = total ? `${total} mensagem(ns) não lida(s)` : 'tudo lido';
        updateCloseBtn();
      } catch (e) { /* polling silencioso */ }
    }

    function rebuildThreadList(threads) {
      const box = document.getElementById('chat-thread-list');
      if (!box || !threads.length) return;

      box.innerHTML = '';
      for (const t of threads) {
        const btn = document.createElement('button');
        btn.className = 'chat-thread' + (chatAdmin.selected === t.id ? ' active' : '');
        btn.dataset.thread = t.id;
        btn.onclick = () => selectThread(t.id);

        const top = document.createElement('div');
        top.className = 'chat-thread-top';
        const email = document.createElement('span');
        email.className = 'chat-thread-email';
        email.textContent = t.order_email;
        top.appendChild(email);

        if (t.unread > 0) {
          const badge = document.createElement('span');
          badge.className = 'chat-unread';
          badge.textContent = t.unread;
          top.appendChild(badge);
        }
        if (t.status === 'closed') {
          const tag = document.createElement('span');
          tag.className = 'chat-closed-tag';
          tag.textContent = 'encerrado';
          top.appendChild(tag);
        }

        const sub = document.createElement('div');
        sub.className = 'chat-thread-sub';
        sub.textContent = `${t.product_name} · pedido #${t.order_id}`;

        const last = document.createElement('div');
        last.className = 'chat-thread-last';
        last.textContent = (t.last_message || '').slice(0, 60);

        btn.appendChild(top);
        btn.appendChild(sub);
        btn.appendChild(last);
        box.appendChild(btn);
      }
    }

    setInterval(refreshThreads, 6000);
    refreshThreads();

    // ════════════════════════════════════════════════
    //  CUPONS
    // ════════════════════════════════════════════════

    async function createCoupon() {
      const payload = {
        code:       document.getElementById('cp-code').value.trim(),
        type:       document.getElementById('cp-type').value,
        value:      document.getElementById('cp-value').value,
        max_uses:   document.getElementById('cp-max').value.trim() || '-1',
        expires_at: document.getElementById('cp-expires').value || null
      };

      try {
        const res = await fetch('/admin/api/coupons/create', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });
        const data = await res.json();
        if (res.ok) {
          showToast('Cupom "' + data.coupon.code + '" criado!', 'success');
          setTimeout(() => location.reload(), 800);
        } else {
          showToast(data.error || 'Erro ao criar cupom.', 'error');
        }
      } catch (err) {
        showToast('Erro de conexão.', 'error');
      }
    }

    async function toggleCoupon(id) {
      try {
        const res = await fetch('/admin/api/coupons/' + id + '/toggle', { method: 'POST' });
        if (res.ok) location.reload();
        else showToast('Erro ao alterar cupom.', 'error');
      } catch (err) {
        showToast('Erro de conexão.', 'error');
      }
    }

    async function deleteCoupon(id, code) {
      if (!confirm('Excluir o cupom "' + code + '" de vez?')) return;

      try {
        const res = await fetch('/admin/api/coupons/' + id + '/delete', { method: 'POST' });
        if (res.ok) {
          showToast('Cupom excluído.', 'success');
          setTimeout(() => location.reload(), 800);
        } else {
          showToast('Erro ao excluir.', 'error');
        }
      } catch (err) {
        showToast('Erro de conexão.', 'error');
      }
    }
  </script>
</body>
</html>
