<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin Panel — Roblox Supplyz</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Orbitron:wght@700;800;900&display=swap" rel="stylesheet">
  <style>
    /* ================================================
       ADMIN PANEL — Dark Cyber Design System
       Roblox Supplyz
       ================================================ */

    :root {
      --bg-deepest: #06090f;
      --bg-deep: #0a0f1a;
      --bg-card: #0d1322;
      --bg-card-hover: #111a2e;
      --bg-surface: #131c30;
      --border-dim: #1a2540;
      --border-mid: #243356;
      --accent-blue: #3b82f6;
      --accent-blue-hover: #2563eb;
      --accent-cyan: #22d3ee;
      --accent-green: #22c55e;
      --accent-orange: #f97316;
      --accent-red: #ef4444;
      --accent-purple: #a855f7;
      --text-primary: #e8ecf4;
      --text-secondary: #8896b3;
      --text-muted: #5a6a8a;
      --glow-blue: 0 0 20px rgba(59,130,246,0.3), 0 0 60px rgba(59,130,246,0.1);
    }

    /* ── Reset & Base ── */
    *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

    body {
      font-family: 'Inter', system-ui, -apple-system, sans-serif;
      background: var(--bg-deepest);
      color: var(--text-primary);
      -webkit-font-smoothing: antialiased;
      min-height: 100vh;
      line-height: 1.5;
    }

    .font-display { font-family: 'Orbitron', 'Inter', sans-serif; }
    a { color: var(--accent-blue); text-decoration: none; }
    a:hover { text-decoration: underline; }

    /* ── Scrollbar ── */
    ::-webkit-scrollbar { width: 6px; }
    ::-webkit-scrollbar-track { background: var(--bg-deep); }
    ::-webkit-scrollbar-thumb { background: var(--border-mid); border-radius: 3px; }

    /* ── Container ── */
    .container { max-width: 1200px; margin: 0 auto; padding-left: 24px; padding-right: 24px; }

    /* ════════════════════════════════════════════════
       HEADER
       ════════════════════════════════════════════════ */
    .site-header {
      background: rgba(10,15,26,0.92);
      border-bottom: 1px solid var(--border-dim);
      backdrop-filter: blur(12px);
      position: sticky; top: 0; z-index: 50;
    }
    .header-inner {
      display: flex; align-items: center; justify-content: space-between;
      padding-top: 12px; padding-bottom: 12px;
    }
    .header-left { display: flex; align-items: center; gap: 16px; }
    .logo { display: flex; align-items: center; gap: 10px; text-decoration: none; }
    .logo-icon {
      width: 34px; height: 34px;
      background: linear-gradient(135deg, var(--accent-blue), var(--accent-cyan));
      border-radius: 8px;
      display: flex; align-items: center; justify-content: center;
      font-weight: 900; font-size: 14px; color: #fff;
      font-family: 'Orbitron', sans-serif;
    }
    .logo-text {
      font-family: 'Orbitron', sans-serif;
      font-size: 15px; font-weight: 800;
      letter-spacing: 0.04em; color: var(--text-primary);
    }
    .admin-badge {
      background: rgba(59,130,246,0.12);
      border: 1px solid rgba(59,130,246,0.25);
      border-radius: 6px; padding: 3px 10px;
      font-size: 11px; font-weight: 700; color: var(--accent-blue);
      letter-spacing: 0.06em; text-transform: uppercase;
      font-family: 'Orbitron', sans-serif;
    }

    .nav { display: flex; align-items: center; gap: 16px; font-size: 13px; font-weight: 500; }
    .nav-link { color: var(--text-secondary); transition: color 0.15s; text-decoration: none; }
    .nav-link:hover { color: var(--accent-blue); text-decoration: none; }
    .nav-divider { width: 1px; height: 20px; background: var(--border-dim); }

    .user-menu { display: flex; align-items: center; gap: 10px; }
    .user-avatar { width: 30px; height: 30px; border-radius: 50%; border: 2px solid var(--border-dim); }
    .user-info { display: flex; flex-direction: column; }
    .user-name { font-size: 12px; font-weight: 700; color: var(--text-primary); line-height: 1.2; }
    .user-email { font-size: 10px; color: var(--text-muted); line-height: 1.2; }

    .btn-sm {
      padding: 5px 14px; border-radius: 6px;
      font-size: 11px; font-weight: 600; cursor: pointer;
      transition: all 0.15s; border: 1px solid transparent;
      text-decoration: none; display: inline-block;
    }
    .btn-outline {
      background: var(--bg-surface); border-color: var(--border-dim);
      color: var(--text-secondary);
    }
    .btn-outline:hover { border-color: var(--accent-blue); color: var(--text-primary); text-decoration: none; }

    /* ════════════════════════════════════════════════
       MAIN CONTENT
       ════════════════════════════════════════════════ */
    .admin-main { padding: 32px 0 60px; }

    .page-title {
      font-family: 'Orbitron', sans-serif;
      font-size: 22px; font-weight: 800;
      letter-spacing: 0.04em;
      margin-bottom: 24px;
    }

    /* ════════════════════════════════════════════════
       STATS CARDS
       ════════════════════════════════════════════════ */
    .stats-grid {
      display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px;
      margin-bottom: 32px;
    }
    .stat-card {
      background: var(--bg-card);
      border: 1px solid var(--border-dim);
      border-radius: 12px; padding: 20px;
      display: flex; align-items: flex-start; gap: 14px;
      transition: transform 0.2s, box-shadow 0.2s;
    }
    .stat-card:hover { transform: translateY(-2px); box-shadow: 0 8px 30px rgba(0,0,0,0.4); }
    .stat-icon {
      width: 44px; height: 44px;
      background: rgba(59,130,246,0.1);
      border: 1px solid rgba(59,130,246,0.2);
      border-radius: 10px;
      display: flex; align-items: center; justify-content: center;
      font-size: 20px; flex-shrink: 0;
    }
    .stat-icon.orange { background: rgba(249,115,22,0.1); border-color: rgba(249,115,22,0.2); }
    .stat-icon.green { background: rgba(34,197,94,0.1); border-color: rgba(34,197,94,0.2); }
    .stat-content { flex: 1; }
    .stat-label {
      font-size: 11px; font-weight: 600; color: var(--text-muted);
      text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 4px;
    }
    .stat-value {
      font-size: 26px; font-weight: 800; color: var(--text-primary);
      line-height: 1.2;
    }
    .stat-value.orange { color: var(--accent-orange); }
    .stat-value.green { color: var(--accent-green); }

    /* ════════════════════════════════════════════════
       SECTIONS
       ════════════════════════════════════════════════ */
    .admin-section {
      background: var(--bg-card);
      border: 1px solid var(--border-dim);
      border-radius: 12px;
      margin-bottom: 24px;
      overflow: hidden;
    }
    .section-header {
      padding: 18px 24px;
      border-bottom: 1px solid var(--border-dim);
      display: flex; align-items: center; justify-content: space-between;
      flex-wrap: wrap; gap: 12px;
    }
    .section-title {
      font-family: 'Orbitron', sans-serif;
      font-size: 14px; font-weight: 800;
      letter-spacing: 0.04em;
    }

    /* ── Filter dropdown ── */
    .filter-select {
      background: var(--bg-surface);
      border: 1px solid var(--border-dim);
      border-radius: 6px;
      color: var(--text-secondary);
      padding: 6px 12px;
      font-size: 12px; font-weight: 600;
      font-family: 'Inter', sans-serif;
      cursor: pointer;
      outline: none;
      transition: border-color 0.15s;
    }
    .filter-select:focus { border-color: var(--accent-blue); }
    .filter-select option { background: var(--bg-deep); color: var(--text-primary); }

    /* ════════════════════════════════════════════════
       TABLES
       ════════════════════════════════════════════════ */
    .table-wrapper { overflow-x: auto; }

    table {
      width: 100%; border-collapse: collapse;
      font-size: 13px;
    }
    thead th {
      text-align: left; padding: 12px 16px;
      font-size: 11px; font-weight: 600;
      color: var(--text-muted);
      text-transform: uppercase; letter-spacing: 0.06em;
      border-bottom: 1px solid var(--border-dim);
      white-space: nowrap;
      background: var(--bg-deep);
    }
    tbody tr {
      border-bottom: 1px solid rgba(26,37,64,0.5);
      transition: background 0.12s;
    }
    tbody tr:hover { background: var(--bg-card-hover); }
    tbody tr:last-child { border-bottom: none; }
    tbody td {
      padding: 10px 16px;
      color: var(--text-secondary);
      white-space: nowrap;
    }

    /* ── Status badges ── */
    .badge {
      display: inline-block;
      padding: 3px 10px; border-radius: 20px;
      font-size: 11px; font-weight: 700;
      text-transform: capitalize;
    }
    .badge-pending {
      background: rgba(249,115,22,0.12); color: var(--accent-orange);
      border: 1px solid rgba(249,115,22,0.25);
    }
    .badge-approved {
      background: rgba(34,197,94,0.12); color: var(--accent-green);
      border: 1px solid rgba(34,197,94,0.25);
    }
    .badge-rejected {
      background: rgba(239,68,68,0.12); color: var(--accent-red);
      border: 1px solid rgba(239,68,68,0.25);
    }
    .badge-cancelled {
      background: rgba(90,106,138,0.12); color: var(--text-muted);
      border: 1px solid rgba(90,106,138,0.25);
    }
    .badge-active {
      background: rgba(34,197,94,0.12); color: var(--accent-green);
      border: 1px solid rgba(34,197,94,0.25);
    }
    .badge-inactive {
      background: rgba(239,68,68,0.12); color: var(--accent-red);
      border: 1px solid rgba(239,68,68,0.25);
    }
    .badge-revoked {
      background: rgba(239,68,68,0.12); color: var(--accent-red);
      border: 1px solid rgba(239,68,68,0.25);
    }

    /* ── Action buttons ── */
    .btn-action {
      padding: 4px 12px; border-radius: 6px;
      font-size: 11px; font-weight: 700; cursor: pointer;
      border: 1px solid transparent;
      transition: all 0.15s;
      font-family: 'Inter', sans-serif;
      display: inline-flex; align-items: center; gap: 4px;
    }
    .btn-approve {
      background: rgba(34,197,94,0.12); color: var(--accent-green);
      border-color: rgba(34,197,94,0.3);
    }
    .btn-approve:hover { background: rgba(34,197,94,0.25); }
    .btn-cancel {
      background: rgba(239,68,68,0.12); color: var(--accent-red);
      border-color: rgba(239,68,68,0.3);
    }
    .btn-cancel:hover { background: rgba(239,68,68,0.25); }
    .btn-toggle {
      background: rgba(59,130,246,0.12); color: var(--accent-blue);
      border-color: rgba(59,130,246,0.3);
    }
    .btn-toggle:hover { background: rgba(59,130,246,0.25); }
    .btn-save {
      background: rgba(34,197,94,0.12); color: var(--accent-green);
      border-color: rgba(34,197,94,0.3);
    }
    .btn-save:hover { background: rgba(34,197,94,0.25); }
    .btn-copy-key {
      background: rgba(59,130,246,0.12); color: var(--accent-blue);
      border-color: rgba(59,130,246,0.3);
    }
    .btn-copy-key:hover { background: rgba(59,130,246,0.25); }
    .btn-revoke {
      background: rgba(239,68,68,0.12); color: var(--accent-red);
      border-color: rgba(239,68,68,0.3);
    }
    .btn-revoke:hover { background: rgba(239,68,68,0.25); }

    .actions-cell { display: flex; gap: 6px; align-items: center; }

    /* ── Stock input ── */
    .stock-input {
      width: 70px; padding: 4px 8px;
      background: var(--bg-surface); border: 1px solid var(--border-dim);
      border-radius: 6px; color: var(--text-primary);
      font-size: 13px; font-family: 'Inter', sans-serif;
      outline: none; text-align: center;
      transition: border-color 0.15s;
    }
    .stock-input:focus { border-color: var(--accent-blue); }

    /* ── License key monospace ── */
    .license-key {
      font-family: 'JetBrains Mono', 'Fira Code', 'Cascadia Code', monospace;
      font-size: 12px; color: var(--text-primary);
      letter-spacing: 0.02em;
      background: var(--bg-surface);
      padding: 3px 8px; border-radius: 4px;
      border: 1px solid var(--border-dim);
    }

    /* ── Empty state ── */
    .empty-state {
      text-align: center; padding: 40px 24px;
      color: var(--text-muted); font-size: 13px;
    }

    /* ════════════════════════════════════════════════
       FOOTER
       ════════════════════════════════════════════════ */
    .site-footer { border-top: 1px solid var(--border-dim); background: var(--bg-deep); }
    .footer-inner {
      padding-top: 20px; padding-bottom: 20px;
      display: flex; align-items: center; justify-content: space-between;
      font-size: 11px; color: var(--text-muted);
    }
    .footer-left { display: flex; align-items: center; gap: 6px; }
    .footer-brand { font-weight: 700; color: var(--text-secondary); }
    .footer-dot { opacity: 0.4; }
    .footer-links { display: flex; gap: 16px; }
    .footer-links a { color: var(--text-muted); text-decoration: none; }
    .footer-links a:hover { color: var(--accent-blue); }

    /* ════════════════════════════════════════════════
       RESPONSIVE
       ════════════════════════════════════════════════ */
    @media (max-width: 1024px) {
      .stats-grid { grid-template-columns: repeat(2, 1fr); }
    }

    @media (max-width: 768px) {
      .stats-grid { grid-template-columns: 1fr; }
      .header-inner { flex-wrap: wrap; gap: 10px; }
      .nav { gap: 10px; flex-wrap: wrap; }
      .section-header { padding: 14px 16px; }
      thead th, tbody td { padding: 8px 12px; font-size: 12px; }
      .page-title { font-size: 18px; }
      .stat-value { font-size: 22px; }
      .admin-badge { display: none; }
    }

    @media (max-width: 480px) {
      .container { padding-left: 12px; padding-right: 12px; }
      .user-info { display: none; }
    }

    /* ── Toast notification ── */
    .toast {
      position: fixed; bottom: 24px; right: 24px;
      background: var(--bg-card);
      border: 1px solid var(--border-dim);
      border-radius: 10px; padding: 12px 20px;
      font-size: 13px; font-weight: 600;
      color: var(--text-primary);
      box-shadow: 0 8px 30px rgba(0,0,0,0.5);
      z-index: 999;
      transform: translateY(100px); opacity: 0;
      transition: all 0.3s ease;
    }
    .toast.show { transform: translateY(0); opacity: 1; }
    .toast.success { border-color: rgba(34,197,94,0.4); color: var(--accent-green); }
    .toast.error { border-color: rgba(239,68,68,0.4); color: var(--accent-red); }

    /* ── Pool de keys ── */
    .pool-list { padding: 16px; display: flex; flex-direction: column; gap: 14px; }
    .pool-row {
      background: var(--bg-deep); border: 1px solid var(--border-dim);
      border-radius: 10px; padding: 14px 16px;
    }
    .pool-head { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; margin-bottom: 10px; }
    .pool-name { color: var(--text-primary); font-weight: 700; font-size: 13px; margin-right: 4px; }
    .pool-add { display: flex; gap: 10px; align-items: flex-start; }
    .pool-add .btn-action { flex-shrink: 0; margin-top: 2px; }
    .pool-textarea {
      flex: 1; width: 100%; min-height: 68px; resize: vertical;
      background: var(--bg-surface); border: 1px solid var(--border-dim);
      border-radius: 8px; color: var(--text-primary);
      font-family: 'JetBrains Mono', 'Fira Code', 'Consolas', monospace;
      font-size: 12px; line-height: 1.6;
      padding: 8px 12px; outline: none;
      transition: border-color 0.15s;
    }
    .pool-textarea:focus { border-color: var(--accent-blue); }
    .pool-textarea::placeholder { color: var(--text-muted); }
    @media (max-width: 640px) { .pool-add { flex-direction: column; } }

    /* ── Formulário de produto ── */
    .product-form {
      margin: 16px; padding: 18px;
      background: var(--bg-deep);
      border: 1px solid var(--border-mid); border-radius: 10px;
    }
    .pf-title {
      font-family: 'Orbitron', sans-serif;
      font-size: 12px; font-weight: 800; letter-spacing: 0.06em;
      color: var(--accent-blue); margin-bottom: 14px;
    }
    .pf-grid {
      display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px;
      margin-bottom: 14px;
    }
    .pf-wide { grid-column: 1 / -1; }
    .pf-field { display: flex; flex-direction: column; gap: 5px; }
    .pf-label {
      font-size: 10px; font-weight: 600; color: var(--text-muted);
      text-transform: uppercase; letter-spacing: 0.07em;
    }
    .pf-input {
      padding: 8px 12px;
      background: var(--bg-surface); border: 1px solid var(--border-dim);
      border-radius: 8px; color: var(--text-primary);
      font-size: 12px; font-family: 'Inter', sans-serif;
      outline: none; transition: border-color 0.15s;
      width: 100%;
    }
    .pf-input:focus { border-color: var(--accent-blue); }
    .pf-input:disabled { opacity: 0.5; }
    .pf-actions { display: flex; align-items: center; gap: 10px; }
    .pf-note { font-size: 11px; color: var(--accent-orange); }
    @media (max-width: 640px) { .pf-grid { grid-template-columns: 1fr; } }

    /* ── Chat admin ── */
    .chat-count { font-size: 11px; color: var(--text-muted); }
    .chat-admin-grid {
      display: grid; grid-template-columns: 300px 1fr;
      min-height: 420px;
      border-top: 1px solid var(--border-dim);
    }
    .chat-thread-list {
      border-right: 1px solid var(--border-dim);
      max-height: 520px; overflow-y: auto;
      display: flex; flex-direction: column;
    }
    .chat-thread {
      background: none; border: none;
      border-bottom: 1px solid var(--border-dim);
      padding: 12px 14px;
      text-align: left; cursor: pointer;
      transition: background 0.12s;
      font-family: 'Inter', sans-serif;
    }
    .chat-thread:hover { background: var(--bg-card-hover); }
    .chat-thread.active { background: rgba(59,130,246,0.08); border-left: 3px solid var(--accent-blue); }
    .chat-thread-top { display: flex; align-items: center; gap: 8px; }
    .chat-thread-email {
      font-size: 12px; font-weight: 700; color: var(--text-primary);
      overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
    }
    .chat-unread {
      background: var(--accent-blue); color: #fff;
      font-size: 9px; font-weight: 800;
      border-radius: 10px; padding: 1px 7px;
      margin-left: auto;
    }
    .chat-closed-tag {
      font-size: 9px; font-weight: 700; color: var(--text-muted);
      border: 1px solid var(--border-dim); border-radius: 4px;
      padding: 1px 5px; text-transform: uppercase;
    }
    .chat-thread-sub { font-size: 10px; color: var(--text-muted); margin-top: 3px; }
    .chat-thread-last {
      font-size: 11px; color: var(--text-secondary); margin-top: 4px;
      overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
    }
    .chat-pane { display: flex; flex-direction: column; }
    .chat-pane-head {
      padding: 12px 16px;
      border-bottom: 1px solid var(--border-dim);
      font-size: 12px; font-weight: 700; color: var(--text-secondary);
    }
    .chat-pane-messages {
      flex: 1; overflow-y: auto;
      max-height: 400px;
      padding: 14px 16px;
      display: flex; flex-direction: column; gap: 8px;
    }
    .chat-msg { display: flex; }
    .chat-msg-me { justify-content: flex-end; }
    .chat-msg-them { justify-content: flex-start; }
    .chat-bubble { max-width: 75%; padding: 8px 12px; border-radius: 10px; }
    .chat-msg-me .chat-bubble {
      background: rgba(59,130,246,0.14);
      border: 1px solid rgba(59,130,246,0.3);
      color: var(--text-primary);
    }
    .chat-msg-them .chat-bubble {
      background: var(--bg-surface);
      border: 1px solid var(--border-dim);
      color: var(--text-secondary);
    }
    .chat-body { font-size: 13px; line-height: 1.45; white-space: pre-wrap; word-break: break-word; }
    .chat-time { font-size: 9px; color: var(--text-muted); margin-top: 4px; text-align: right; }
    .chat-pane-input {
      display: flex; gap: 8px; align-items: center;
      padding: 10px 14px;
      border-top: 1px solid var(--border-dim);
      background: var(--bg-deep);
    }
    .chat-pane-input input {
      flex: 1; padding: 8px 12px;
      background: var(--bg-surface); border: 1px solid var(--border-dim);
      border-radius: 8px; color: var(--text-primary);
      font-size: 12px; font-family: 'Inter', sans-serif;
      outline: none;
    }
    .chat-pane-input input:focus { border-color: var(--accent-blue); }
    @media (max-width: 900px) {
      .chat-admin-grid { grid-template-columns: 1fr; }
      .chat-thread-list { border-right: none; border-bottom: 1px solid var(--border-dim); max-height: 220px; }
    }

    /* ── Cupons ── */
    .coupon-form {
      margin: 16px; padding: 18px 18px 8px;
      background: var(--bg-deep);
      border: 1px solid var(--border-dim); border-radius: 10px;
    }
    .coupon-code-tag {
      font-family: 'JetBrains Mono', 'Fira Code', 'Consolas', monospace;
      background: rgba(168,85,247,0.12);
      border: 1px solid rgba(168,85,247,0.3);
      color: var(--accent-purple);
      padding: 2px 8px; border-radius: 4px;
      font-size: 12px; font-weight: 700; letter-spacing: 0.06em;
    }
  </style>
</head>
<body>

  <!-- ==================== HEADER / NAV ==================== -->
  <header class="site-header">
    <div class="container header-inner">
      <div class="header-left">
        <a href="/" class="logo">
          <div class="logo-icon">RS</div>
          <span class="logo-text">ROBLOX SUPPLYZ</span>
        </a>
        <span class="admin-badge">Admin Panel</span>
      </div>

      <nav class="nav">
        <a href="/" class="nav-link">← Voltar à Loja</a>
        <div class="nav-divider"></div>

        <% if (user) { %>
          <div class="user-menu">
            <img src="<%= user.avatar %>" alt="" class="user-avatar" referrerpolicy="no-referrer">
            <div class="user-info">
              <span class="user-name"><%= user.name %></span>
              <span class="user-email"><%= user.email %></span>
            </div>
            <a href="/auth/logout" class="btn-sm btn-outline">Sair</a>
          </div>
        <% } %>
      </nav>
    </div>
  </header>

  <!-- ==================== MAIN ==================== -->
  <main class="container admin-main">

    <h1 class="page-title font-display">DASHBOARD</h1>

    <!-- ==================== STATS CARDS ==================== -->
    <div class="stats-grid">
      <!-- Total de Pedidos -->
      <div class="stat-card">
        <div class="stat-icon">📦</div>
        <div class="stat-content">
          <div class="stat-label">Total de Pedidos</div>
          <div class="stat-value"><%= stats.totalOrders %></div>
        </div>
      </div>

      <!-- Receita Total -->
      <div class="stat-card">
        <div class="stat-icon">💰</div>
        <div class="stat-content">
          <div class="stat-label">Receita Total</div>
          <div class="stat-value">R$ <%= stats.totalRevenue.toFixed(2) %></div>
        </div>
      </div>

      <!-- Pedidos Pendentes -->
      <div class="stat-card">
        <div class="stat-icon orange">⏳</div>
        <div class="stat-content">
          <div class="stat-label">Pedidos Pendentes</div>
          <div class="stat-value orange"><%= stats.pendingOrders %></div>
        </div>
      </div>

      <!-- Pedidos Aprovados -->
      <div class="stat-card">
        <div class="stat-icon green">✅</div>
        <div class="stat-content">
          <div class="stat-label">Pedidos Aprovados</div>
          <div class="stat-value green"><%= stats.approvedOrders %></div>
        </div>
      </div>
    </div>

    <!-- ==================== CHAT SUPORTE ==================== -->
    <div class="admin-section">
      <div class="section-header">
        <h2 class="section-title font-display">CHAT SUPORTE</h2>
        <span id="chat-admin-count" class="chat-count"></span>
      </div>
      <div class="chat-admin-grid">
        <div class="chat-thread-list" id="chat-thread-list">
          <% if (!threads.length) { %>
            <div class="empty-state">Nenhuma conversa ainda.</div>
          <% } %>
          <% threads.forEach(t => { %>
            <button class="chat-thread" data-thread="<%= t.id %>" onclick="selectThread(<%= t.id %>)">
              <div class="chat-thread-top">
                <span class="chat-thread-email"><%= t.order_email %></span>
                <% if (t.unread > 0) { %><span class="chat-unread"><%= t.unread %></span><% } %>
                <% if (t.status === 'closed') { %><span class="chat-closed-tag">encerrado</span><% } %>
              </div>
              <div class="chat-thread-sub"><%= t.product_name %> · pedido #<%= t.order_id %></div>
              <div class="chat-thread-last"><%= (t.last_message || '').slice(0, 60) %></div>
            </button>
          <% }); %>
        </div>
        <div class="chat-pane">
          <div class="chat-pane-head" id="chat-pane-head">Selecione uma conversa à esquerda</div>
          <div class="chat-pane-messages" id="admin-chat-messages"></div>
          <div class="chat-pane-input" id="chat-pane-input" style="display:none;">
            <input type="text" id="admin-chat-text" placeholder="Responder o cliente…" maxlength="2000">
            <button class="btn-action btn-save" onclick="sendAdminMessage()">Enviar</button>
            <button class="btn-action btn-cancel" id="chat-close-btn" onclick="toggleThreadStatus()">Encerrar</button>
          </div>
        </div>
      </div>
    </div>

    <!-- ==================== ORDERS TABLE ==================== -->
    <div class="admin-section">
      <div class="section-header">
        <h2 class="section-title font-display">PEDIDOS</h2>
        <select class="filter-select" onchange="filterByStatus(this.value)">
          <option value="all" <%= statusFilter === 'all' ? 'selected' : '' %>>Todos os Status</option>
          <option value="pending" <%= statusFilter === 'pending' ? 'selected' : '' %>>Pendentes</option>
          <option value="approved" <%= statusFilter === 'approved' ? 'selected' : '' %>>Aprovados</option>
          <option value="rejected" <%= statusFilter === 'rejected' ? 'selected' : '' %>>Rejeitados</option>
          <option value="cancelled" <%= statusFilter === 'cancelled' ? 'selected' : '' %>>Cancelados</option>
        </select>
      </div>
      <div class="table-wrapper">
        <% if (orders.length === 0) { %>
          <div class="empty-state">Nenhum pedido encontrado.</div>
        <% } else { %>
        <table>
          <thead>
            <tr>
              <th>ID</th>
              <th>E-mail</th>
              <th>Produto</th>
              <th>Qtd</th>
              <th>Total</th>
              <th>Status</th>
              <th>Data</th>
              <th>Ações</th>
            </tr>
          </thead>
          <tbody>
            <% orders.forEach(order => { %>
            <tr>
              <td style="color: var(--text-primary); font-weight: 600;">#<%= order.id %></td>
              <td><%= order.email %></td>
              <td style="color: var(--text-primary);"><%= order.description || order.product_name %><% if (order.coupon_code) { %> <span class="coupon-code-tag" title="desconto de R$ <%= (order.discount || 0).toFixed(2).replace('.', ',') %>" style="font-size:9px; padding:0 5px;"><%= order.coupon_code %></span><% } %></td>
              <td><%= order.quantity %></td>
              <td style="color: var(--text-primary); font-weight: 700;">R$ <%= parseFloat(order.total).toFixed(2) %></td>
              <td>
                <span class="badge badge-<%= order.status %>"><%= order.status %></span>
              </td>
              <td><%= new Date(order.created_at).toLocaleDateString('pt-BR') %></td>
              <td>
                <% if (order.status === 'pending') { %>
                <div class="actions-cell">
                  <button class="btn-action btn-approve" onclick="approveOrder(<%= order.id %>)">✓ Aprovar</button>
                  <button class="btn-action btn-cancel" onclick="cancelOrder(<%= order.id %>)">✕ Cancelar</button>
                </div>
                <% } else { %>
                <span style="color: var(--text-muted); font-size: 12px;">—</span>
                <% } %>
              </td>
            </tr>
            <% }); %>
          </tbody>
        </table>
        <% } %>
      </div>
    </div>

    <!-- ==================== PRODUCTS TABLE ==================== -->
    <div class="admin-section">
      <div class="section-header">
        <h2 class="section-title font-display">PRODUTOS</h2>
        <button class="btn-action btn-save" onclick="openProductForm()">＋ Novo Produto</button>
      </div>

      <div class="product-form" id="product-form" style="display:none;">
        <div class="pf-title" id="pf-title">NOVO PRODUTO</div>
        <div class="pf-grid">
          <div class="pf-field">
            <label class="pf-label">Nome *</label>
            <input type="text" id="pf-name" class="pf-input" placeholder="Aura Executor — Mensal" maxlength="80">
          </div>
          <div class="pf-field">
            <label class="pf-label">ID (slug — vazio gera do nome)</label>
            <input type="text" id="pf-slug" class="pf-input" placeholder="aura-executor" maxlength="40">
          </div>
          <div class="pf-field">
            <label class="pf-label">Preço R$ *</label>
            <input type="number" id="pf-price" class="pf-input" step="0.01" min="0" placeholder="29.90">
          </div>
          <div class="pf-field">
            <label class="pf-label">Tipo de key *</label>
            <select id="pf-type" class="filter-select" onchange="pfToggleStock()">
              <option value="pool">Pool do fornecedor (keys coladas)</option>
              <option value="generated">Gerada pela loja (RYU-…)</option>
            </select>
          </div>
          <div class="pf-field" id="pf-stock-field" style="display:none;">
            <label class="pf-label">Estoque inicial (−1 = ilimitado)</label>
            <input type="number" id="pf-stock" class="pf-input" placeholder="-1">
          </div>
          <div class="pf-field">
            <label class="pf-label">Imagem — URL</label>
            <input type="text" id="pf-image" class="pf-input" placeholder="https://… ou /uploads/…" maxlength="500">
          </div>
          <div class="pf-field">
            <label class="pf-label">Imagem — arquivo (png/jpg/webp/gif, 5MB)</label>
            <input type="file" id="pf-file" class="pf-input" accept="image/png,image/jpeg,image/webp,image/gif">
          </div>
          <div class="pf-field">
            <label class="pf-label">Grupo de plano (ex.: wave-executor)</label>
            <input type="text" id="pf-group" class="pf-input" placeholder="deixe igual entre as variantes" maxlength="40">
          </div>
          <div class="pf-field">
            <label class="pf-label">Rótulo do plano</label>
            <input type="text" id="pf-plan" class="pf-input" placeholder="Mensal / Semanal / Lifetime" maxlength="30">
          </div>
          <div class="pf-field pf-wide">
            <label class="pf-label">Descrição (texto do card)</label>
            <input type="text" id="pf-desc" class="pf-input" placeholder="Descrição curta exibida na vitrine" maxlength="300">
          </div>
        </div>
        <div class="pf-actions">
          <button class="btn-action btn-save" onclick="saveProduct()">💾 Salvar produto</button>
          <button class="btn-action btn-cancel" onclick="closeProductForm()">Fechar</button>
          <span class="pf-note" id="pf-note"></span>
        </div>
      </div>
      <div class="table-wrapper">
        <% if (products.length === 0) { %>
          <div class="empty-state">Nenhum produto cadastrado.</div>
        <% } else { %>
        <table>
          <thead>
            <tr>
              <th>ID</th>
              <th>Nome</th>
              <th>Preço</th>
              <th>Estoque</th>
              <th>Status</th>
              <th>Ações</th>
            </tr>
          </thead>
          <tbody>
            <% products.forEach(product => { %>
            <tr>
              <td style="color: var(--text-primary); font-weight: 600;">#<%= product.id %></td>
              <td style="color: var(--text-primary);"><%= product.name %></td>
              <td style="color: var(--text-primary); font-weight: 700;">R$ <%= parseFloat(product.price).toFixed(2) %></td>
              <td>
                <div class="actions-cell">
                  <% if (product.key_pool) { %>
                    <span style="font-size: 12px; color: var(--text-secondary);">
                      <b style="color: var(--accent-green);"><%= product.available %></b> disponíveis ·
                      <%= product.reserved %> reservadas ·
                      <%= product.sold %> vendidas
                    </span>
                  <% } else if (product.stock === -1) { %>
                    <span style="font-size: 18px; color: var(--text-muted);" title="Estoque ilimitado">∞</span>
                  <% } else { %>
                    <input type="number" class="stock-input" id="stock-<%= product.id %>" value="<%= product.stock %>" min="0">
                    <button class="btn-action btn-save" onclick="updateStock('<%= product.id %>')">Salvar</button>
                  <% } %>
                </div>
              </td>
              <td>
                <% if (product.active) { %>
                  <span class="badge badge-active">Active</span>
                <% } else { %>
                  <span class="badge badge-inactive">Inactive</span>
                <% } %>
              </td>
              <td>
                <div class="actions-cell">
                  <button class="btn-action btn-toggle" onclick="toggleProduct('<%= product.id %>')">
                    <%= product.active ? '⏸ Desativar' : '▶ Ativar' %>
                  </button>
                  <button class="btn-action" onclick="openProductForm('<%= product.id %>')">✏️ Editar</button>
                </div>
              </td>
            </tr>
            <% }); %>
          </tbody>
        </table>
        <% } %>
      </div>
    </div>

    <!-- ==================== CUPONS ==================== -->
    <div class="admin-section">
      <div class="section-header">
        <h2 class="section-title font-display">CUPONS</h2>
        <span style="font-size: 11px; color: var(--text-muted);">uso só é consumido quando o PIX aprova</span>
      </div>

      <div class="coupon-form">
        <div class="pf-grid">
          <div class="pf-field">
            <label class="pf-label">Código *</label>
            <input type="text" id="cp-code" class="pf-input" placeholder="RUA10" maxlength="20" style="text-transform: uppercase;">
          </div>
          <div class="pf-field">
            <label class="pf-label">Tipo *</label>
            <select id="cp-type" class="filter-select">
              <option value="percent">Percentual (%)</option>
              <option value="fixed">Valor fixo (R$)</option>
            </select>
          </div>
          <div class="pf-field">
            <label class="pf-label">Valor *</label>
            <input type="number" id="cp-value" class="pf-input" step="0.01" min="0" placeholder="10">
          </div>
          <div class="pf-field">
            <label class="pf-label">Limite de usos (−1 = ilimitado)</label>
            <input type="number" id="cp-max" class="pf-input" placeholder="-1">
          </div>
          <div class="pf-field">
            <label class="pf-label">Expira em (opcional)</label>
            <input type="date" id="cp-expires" class="pf-input">
          </div>
          <div class="pf-field" style="justify-content:flex-end;">
            <button class="btn-action btn-save" onclick="createCoupon()">＋ Criar cupom</button>
          </div>
        </div>
      </div>

      <div class="table-wrapper">
        <table>
          <thead>
            <tr>
              <th>Código</th><th>Desconto</th><th>Usos</th><th>Expira</th><th>Estado</th><th></th>
            </tr>
          </thead>
          <tbody>
            <% if (!coupons.length) { %>
              <tr><td colspan="6" style="text-align:center; color:var(--text-muted); padding:24px;">Nenhum cupom criado ainda.</td></tr>
            <% } %>
            <% coupons.forEach(c => { %>
              <tr>
                <td><span class="coupon-code-tag"><%= c.code %></span></td>
                <td><%= c.type === 'percent' ? c.value + '%' : 'R$ ' + c.value.toFixed(2).replace('.', ',') %></td>
                <td><%= c.uses %><%= c.max_uses === -1 ? '' : ' / ' + c.max_uses %></td>
                <td><%= c.expires_at ? String(c.expires_at).slice(0, 10).split('-').reverse().join('/') : '—' %></td>
                <td>
                  <span class="badge <%= c.active ? 'badge-active' : 'badge-inactive' %>">
                    <%= c.active ? 'ativo' : 'off' %>
                  </span>
                </td>
                <td>
                  <div class="actions-cell">
                    <button class="btn-action btn-toggle" onclick="toggleCoupon(<%= c.id %>)"><%= c.active ? '⏸' : '▶' %></button>
                    <button class="btn-action btn-cancel" onclick="deleteCoupon(<%= c.id %>, '<%= c.code %>')">🗑</button>
                  </div>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>

    <!-- ==================== POOL DE KEYS ==================== -->
    <div class="admin-section">
      <div class="section-header">
        <h2 class="section-title font-display">POOL DE KEYS (FORNECEDOR)</h2>
        <span style="font-size: 11px; color: var(--text-muted);">1 key = 1 unidade vendável</span>
      </div>
      <div class="pool-list">
        <% const poolProducts = products.filter(p => p.key_pool); %>
        <% if (poolProducts.length === 0) { %>
          <div class="empty-state">Nenhum produto consome pool de keys.</div>
        <% } %>
        <% poolProducts.forEach(p => { %>
          <div class="pool-row">
            <div class="pool-head">
              <span class="pool-name"><%= p.name %></span>
              <span class="badge badge-active"><%= p.available %> disponíveis</span>
              <span class="badge badge-pending"><%= p.reserved %> reservadas</span>
              <span class="badge badge-cancelled"><%= p.sold %> vendidas</span>
            </div>
            <div class="pool-add">
              <textarea id="keys-<%= p.id %>" class="pool-textarea" rows="3"
                placeholder="Cole uma key por linha (ex.: login:senha para contas, ou a key do executor)"></textarea>
              <button class="btn-action btn-save" onclick="addKeys('<%= p.id %>')">＋ Adicionar</button>
            </div>
          </div>
        <% }); %>
      </div>
    </div>

    <!-- ==================== LICENSES TABLE ==================== -->
    <div class="admin-section">
      <div class="section-header">
        <h2 class="section-title font-display">LICENÇAS RECENTES</h2>
        <span style="font-size: 11px; color: var(--text-muted);">Últimas 20</span>
      </div>
      <div class="table-wrapper">
        <% if (licenses.length === 0) { %>
          <div class="empty-state">Nenhuma licença encontrada.</div>
        <% } else { %>
        <table>
          <thead>
            <tr>
              <th>Key</th>
              <th>Produto</th>
              <th>E-mail</th>
              <th>Status</th>
              <th>Criado em</th>
              <th>Ações</th>
            </tr>
          </thead>
          <tbody>
            <% licenses.forEach(license => { %>
            <tr>
              <td>
                <span class="license-key" id="key-display-<%= license.id %>" title="Clique em Copiar para ver a key completa"><%=
                  license.license_key.length > 8
                    ? license.license_key.substring(0, 4) + '••••••••' + license.license_key.substring(license.license_key.length - 4)
                    : license.license_key
                %></span>
              </td>
              <td style="color: var(--text-primary);"><%= license.product_name %></td>
              <td><%= license.email %></td>
              <td>
                <% if (license.status === 'active') { %>
                  <span class="badge badge-active">Ativa</span>
                <% } else if (license.status === 'revoked') { %>
                  <span class="badge badge-revoked">Revogada</span>
                <% } else { %>
                  <span class="badge badge-cancelled"><%= license.status %></span>
                <% } %>
              </td>
              <td><%= new Date(license.created_at).toLocaleDateString('pt-BR') %></td>
              <td>
                <div class="actions-cell">
                  <button class="btn-action btn-copy-key" onclick="copyKey('<%= license.license_key %>')">📋 Copiar</button>
                  <% if (license.status === 'active') { %>
                    <button class="btn-action btn-revoke" onclick="revokeLicense(<%= license.id %>)">🚫 Revogar</button>
                  <% } %>
                </div>
              </td>
            </tr>
            <% }); %>
          </tbody>
        </table>
        <% } %>
      </div>
    </div>

  </main>

